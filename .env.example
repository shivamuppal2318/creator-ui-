ADMIN_TOKEN=replace-with-strong-token
# Optional basic auth for admin endpoints
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

# AI providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_PROVIDER=openai
LOCAL_TRANSCRIPTION_PYTHON=python
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_LANGUAGE=
CHAT_PROVIDER=

# Apify
APIFY_TOKEN=
# Preconfigured actor from the attached Apify token page
APIFY_ACTOR_ID=apify~instagram-reel-scraper
APIFY_AUTO_IMPORT_ENABLED=false
APIFY_AUTO_IMPORT_INTERVAL_MINUTES=180
APIFY_AUTO_IMPORT_USERNAME=
APIFY_AUTO_IMPORT_RESULTS_LIMIT=3

# Bright Data
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_DATASET_ID=

# Winster
WINSTER_ENABLED=false
WINSTER_BASE_URL=
WINSTER_API_KEY=
WINSTER_MODEL=
WINSTER_PATH=/chat
